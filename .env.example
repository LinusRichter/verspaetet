# Postgres
POSTGRES_PASSWORD=changeme
POSTGRESQL_VERSION=16

# DB API marketplace credentials (developers.deutschebahn.com).
# Sent as DB-Client-ID / DB-Api-Key headers.
# Timetables (IRIS) subscription:
IRIS_CLIENT_ID=your-timetables-client-id
IRIS_API_KEY=your-timetables-api-key
# Station Data (StaDa) subscription — SEPARATE key pair:
# (falls back to the IRIS pair if unset)
STADA_CLIENT_ID=your-stada-client-id
STADA_API_KEY=your-stada-api-key
# HuggingFace upload (dataset chunks). Create a Write token at
# huggingface.co/settings/tokens; repo must exist (e.g. LinusRichter404/verspaetet)
HF_TOKEN=
HF_REPO=LinusRichter404/verspaetet

# Optional (defaults shown)
# CADENCE_MINUTES=40        # every station is fetched once per cadence
# IRIS_RATE_LIMIT=60        # requests/minute
# EXPORT_TIMEOUT=12h        # one export attempt including the HF upload
# EXPORT_MIN_FREE_GB=25     # an export does not start with less free disk
